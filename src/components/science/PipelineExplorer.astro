---
/**
 * Step-by-step explanation of the OncoNose concept.
 * Wide screens with JavaScript: tabs. Narrow screens or no JavaScript: every step stacked, nothing hidden.
 */
import StepScene from './StepScene.astro';
import { pipeline, statusLabel } from '../../data/pipeline';
---

<div class="explorer" data-explorer>
  <div class="explorer__tabs" role="tablist" aria-label="Steps from breath to follow-up" aria-orientation="vertical" data-tablist>
    {
      pipeline.map((step, i) => (
        <button
          class="explorer__tab"
          role="tab"
          id={`tab-${step.id}`}
          aria-controls={`panel-${step.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          type="button"
          data-tab
        >
          <span class="explorer__num">{i + 1}</span>
          <span class="explorer__tab-title">{step.short}</span>
        </button>
      ))
    }
  </div>

  <div class="explorer__panels">
    {
      pipeline.map((step, i) => (
        <section class="explorer__panel" id={`panel-${step.id}`} aria-labelledby={`title-${step.id}`} data-panel>
          <div class="explorer__scene on-dark">
            <StepScene step={step.id} />
            <p class="explorer__scene-note">Schematic</p>
          </div>
          <div class="explorer__text">
            <p class="explorer__step">
              Step {i + 1} of {pipeline.length}
              <span class:list={['explorer__status', `is-${step.status}`]}>{statusLabel[step.status]}</span>
            </p>
            <h3 id={`title-${step.id}`}>{step.title}</h3>
            <p>{step.happens}</p>
            <h4>What we have to show</h4>
            <p>{step.mustShow}</p>
            <h4>Open questions</h4>
            <ul>
              {step.openQuestions.map((q) => (
                <li>{q}</li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>
</div>

<style>
  .explorer {
    margin-block: var(--sp-6);
    font-family: var(--font-sans);
  }

  .explorer__tabs {
    display: none;
  }

  .explorer__panels {
    display: grid;
    gap: var(--sp-7);
  }

  .explorer__panel {
    display: grid;
    gap: var(--sp-5);
    border-radius: var(--r-figure);
  }

  .explorer__scene {
    position: relative;
    padding: var(--sp-4);
    border-radius: var(--r-figure);
    background: var(--darkfield);
  }

  .explorer__scene-note {
    position: absolute;
    right: var(--sp-3);
    top: var(--sp-2);
    font-size: var(--text-xs);
    color: var(--on-dark-3);
  }

  .explorer__step {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .explorer__status {
    padding: 0.1rem 0.55rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--rule-strong);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-2);
  }

  .explorer__status.is-designing,
  .explorer__status.is-testing {
    color: var(--air-ink);
    border-color: currentColor;
  }

  .explorer__status.is-shown {
    color: var(--metabolism-ink);
    border-color: currentColor;
  }

  .explorer__text h3 {
    margin-top: var(--sp-2);
    font-size: var(--text-h3);
  }

  .explorer__text h4 {
    margin-top: var(--sp-4);
    font-size: 0.95rem;
    font-weight: 650;
  }

  .explorer__text p,
  .explorer__text ul {
    margin-top: var(--sp-2);
    font-family: var(--font-serif);
    max-width: 58ch;
  }

  .explorer__text ul {
    padding-left: 1.1em;
  }

  .explorer__text li + li {
    margin-top: var(--sp-1);
  }

  @media (min-width: 40rem) {
    .explorer__panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }

  /* Tabbed layout, only when JavaScript is available and there is room */
  @media (min-width: 64rem) {
    :global(html.js) .explorer {
      display: grid;
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--sp-6);
      align-items: start;
    }

    :global(html.js) .explorer__tabs {
      display: grid;
      gap: 2px;
      position: relative;
    }

    :global(html.js) .explorer__panel[hidden] {
      display: none;
    }

    :global(html.js) .explorer__panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 80rem) {
    :global(html.js) .explorer__panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .explorer__tab {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 3rem;
    padding: 0.5rem 0.75rem;
    border: 0;
    border-radius: var(--r-control);
    background: transparent;
    color: var(--ink-2);
    font-size: 0.975rem;
    font-weight: 560;
    text-align: left;
    cursor: pointer;
  }

  .explorer__tab:hover {
    background: var(--paper-sunk);
    color: var(--ink);
  }

  .explorer__tab[aria-selected='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .explorer__num {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    font-size: 0.8rem;
    font-weight: 650;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((explorer) => {
    const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-panel]'));
    const wide = window.matchMedia('(min-width: 64rem)');
    let current = 0;

    const select = (index: number, focus = false) => {
      current = index;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => (panel.hidden = wide.matches && i !== index));
      if (focus) tabs[index].focus();
    };

    const applyLayout = () => {
      panels.forEach((panel, i) => {
        if (wide.matches) {
          panel.setAttribute('role', 'tabpanel');
          panel.setAttribute('aria-labelledby', tabs[i].id);
          panel.tabIndex = 0;
        } else {
          panel.removeAttribute('role');
          panel.setAttribute('aria-labelledby', panel.querySelector('h3')!.id);
          panel.removeAttribute('tabindex');
        }
      });
      select(current);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = {
          ArrowDown: (i + 1) % tabs.length,
          ArrowRight: (i + 1) % tabs.length,
          ArrowUp: (i - 1 + tabs.length) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (event.key in keys) {
          event.preventDefault();
          select(keys[event.key], true);
        }
      });
    });

    wide.addEventListener('change', applyLayout);
    applyLayout();
  });
</script>
