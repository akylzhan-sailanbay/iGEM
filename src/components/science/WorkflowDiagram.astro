---
import { workflow } from '../../data/experiments';
---

<ol class="workflow">
  {
    workflow.map((stage, i) => (
      <li class="workflow__stage">
        <div class="workflow__head">
          <span class="workflow__num" aria-hidden="true">
            {i + 1}
          </span>
          <h3>{stage.name}</h3>
        </div>
        <p class="workflow__does">{stage.does}</p>
        <dl class="workflow__meta">
          <div>
            <dt>Measured</dt>
            <dd>{stage.measures}</dd>
          </div>
          <div>
            <dt>Controls</dt>
            <dd>
              <ul>
                {stage.controls.map((control) => (
                  <li>{control}</li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
      </li>
    ))
  }
</ol>

<style>
  .workflow {
    display: grid;
    gap: 0;
    margin: var(--sp-6) 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    border-top: 1px solid var(--rule);
  }

  .workflow__stage {
    display: grid;
    gap: var(--sp-3);
    padding-block: var(--sp-5);
    border-bottom: 1px solid var(--rule);
  }

  .workflow__head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .workflow__num {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.85rem;
    font-weight: 650;
  }

  .workflow h3 {
    font-size: 1.1rem;
  }

  .workflow__does {
    font-family: var(--font-serif);
    max-width: 62ch;
  }

  .workflow__meta {
    display: grid;
    gap: var(--sp-4);
    margin: 0;
    font-size: var(--text-sm);
  }

  .workflow__meta dt {
    font-weight: 650;
    color: var(--ink-3);
    margin-bottom: 0.2rem;
  }

  .workflow__meta dd {
    margin: 0;
    color: var(--ink-2);
  }

  .workflow__meta ul {
    margin: 0;
    padding-left: 1.05em;
  }

  @media (min-width: 52rem) {
    .workflow__stage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--sp-6);
      align-items: start;
    }

    .workflow__head {
      grid-column: 1;
    }

    .workflow__does {
      grid-column: 1;
    }

    .workflow__meta {
      grid-column: 2;
      grid-row: 1 / span 2;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
