---
/**
 * Line chart for dose–response and time-course data, rendered at build time.
 * Every chart also exposes its numbers as a table, so the data is readable without seeing the figure.
 */
import { extent, linearScale, logScale } from '../../lib/scale';
import type { FamilyId } from '../../data/signals';

export interface Point {
  x: number;
  y: number;
  /** Standard deviation or standard error, drawn as an error bar */
  error?: number;
}

export interface Series {
  label: string;
  points: Point[];
  family?: FamilyId;
}

interface Props {
  series: Series[];
  xLabel: string;
  yLabel: string;
  xScaleType?: 'linear' | 'log';
  tableLabel?: string;
}
const { series, xLabel, yLabel, xScaleType = 'linear', tableLabel } = Astro.props;

const width = 720;
const height = 380;
const margin = { top: 16, right: 18, bottom: 56, left: 64 };

const allPoints = series.flatMap((s) => s.points);
const xValues = allPoints.map((p) => p.x);
const yValues = allPoints.flatMap((p) => [p.y - (p.error ?? 0), p.y + (p.error ?? 0)]);

const x =
  xScaleType === 'log'
    ? logScale([Math.min(...xValues), Math.max(...xValues)], [margin.left, width - margin.right])
    : linearScale(extent(xValues, 0.02), [margin.left, width - margin.right]);
const y = linearScale([Math.min(0, ...yValues), Math.max(...yValues) * 1.05], [height - margin.bottom, margin.top]);

const path = (points: Point[]) =>
  points
    .slice()
    .sort((a, b) => a.x - b.x)
    .map((p, i) => `${i === 0 ? 'M' : 'L'}${x(p.x).toFixed(1)} ${y(p.y).toFixed(1)}`)
    .join(' ');

const allX = [...new Set(allPoints.map((p) => p.x))].sort((a, b) => a - b);
---

<div class="linechart">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${yLabel} against ${xLabel}`}>
    <g class="grid">
      {
        y.ticks.map((tick) => (
          <line x1={margin.left} x2={width - margin.right} y1={y(tick)} y2={y(tick)} />
        ))
      }
    </g>

    <g class="axis">
      <line x1={margin.left} x2={margin.left} y1={margin.top} y2={height - margin.bottom} />
      <line x1={margin.left} x2={width - margin.right} y1={height - margin.bottom} y2={height - margin.bottom} />
      {
        y.ticks.map((tick) => (
          <text class="axis__tick" x={margin.left - 10} y={y(tick) + 4} text-anchor="end">
            {y.format(tick)}
          </text>
        ))
      }
      {
        x.ticks.map((tick) => (
          <>
            <line class="axis__mark" x1={x(tick)} x2={x(tick)} y1={height - margin.bottom} y2={height - margin.bottom + 6} />
            <text class="axis__tick" x={x(tick)} y={height - margin.bottom + 22} text-anchor="middle">
              {x.format(tick)}
            </text>
          </>
        ))
      }
      <text class="axis__label" x={(margin.left + width - margin.right) / 2} y={height - 10} text-anchor="middle">
        {xLabel}
      </text>
      <text
        class="axis__label"
        transform={`rotate(-90 16 ${(margin.top + height - margin.bottom) / 2})`}
        x="16"
        y={(margin.top + height - margin.bottom) / 2}
        text-anchor="middle"
      >
        {yLabel}
      </text>
    </g>

    {
      series.map((s) => (
        <g class="series" data-family={s.family}>
          <path class="series__line" d={path(s.points)} />
          {s.points.map((p) => (
            <>
              {p.error ? (
                <line
                  class="series__error"
                  x1={x(p.x)}
                  x2={x(p.x)}
                  y1={y(p.y - p.error)}
                  y2={y(p.y + p.error)}
                />
              ) : null}
              <circle class="series__dot" cx={x(p.x)} cy={y(p.y)} r="4.5" />
            </>
          ))}
        </g>
      ))
    }
  </svg>

  <ul class="linechart__legend">
    {
      series.map((s) => (
        <li data-family={s.family}>
          <span class="linechart__swatch" aria-hidden="true" />
          {s.label}
        </li>
      ))
    }
  </ul>

  <details class="linechart__data">
    <summary>Show the numbers</summary>
    <div class="table-scroll" role="region" aria-label={tableLabel ?? `${yLabel} against ${xLabel}`} tabindex="0">
      <table class="data">
        <thead>
          <tr>
            <th scope="col">{xLabel}</th>
            {series.map((s) => (
              <th scope="col">{s.label}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {
            allX.map((xv) => (
              <tr>
                <th scope="row">{x.format(xv)}</th>
                {series.map((s) => {
                  const point = s.points.find((p) => p.x === xv);
                  return <td>{point ? `${point.y}${point.error ? ` ± ${point.error}` : ''}` : '—'}</td>;
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</div>

<style>
  .linechart svg {
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }

  .grid line {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .axis line {
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .axis__mark {
    stroke-width: 1;
  }

  .axis__tick {
    fill: var(--ink-2);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .axis__label {
    fill: var(--ink);
    font-size: 13px;
    font-weight: 600;
  }

  .series {
    --series-color: var(--ink);
  }

  .series[data-family] {
    --series-color: var(--family-ink);
  }

  .series__line {
    fill: none;
    stroke: var(--series-color);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .series__dot {
    fill: var(--series-color);
    stroke: var(--paper-raised);
    stroke-width: 1.5;
  }

  .series__error {
    stroke: var(--series-color);
    stroke-width: 1.5;
    opacity: 0.8;
  }

  .linechart__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    margin: var(--sp-3) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .linechart__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .linechart__swatch {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--family, var(--ink));
    border: 1.5px solid var(--family-ink, var(--ink));
  }

  .linechart__data {
    margin-top: var(--sp-4);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .linechart__data summary {
    cursor: pointer;
    font-weight: 600;
    padding: var(--sp-2) 0;
  }
</style>
