---
import LogoMark from './LogoMark.astro';
import { navGroups, pagesInGroup } from '../../data/chapters';
import { href } from '../../lib/paths';

interface Props {
  /** Slug of the current page, e.g. "problem"; "" for home */
  current: string;
}
const { current } = Astro.props;

const groups = navGroups.map((group) => {
  const pages = pagesInGroup(group);
  return { group, pages, active: pages.some((p) => p.slug === current) };
});
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="brand" href={href('/')} aria-current={current === '' ? 'page' : undefined}>
      <LogoMark size={30} />
      <span class="brand__name">OncoNose</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul class="nav-desktop__list" role="list">
        {
          groups.map(({ group, pages, active }) => (
            <li class="nav-group" data-nav-group>
              <button
                class="nav-group__trigger"
                type="button"
                aria-expanded="false"
                aria-controls={`nav-panel-${group.toLowerCase()}`}
                data-active={active ? 'true' : undefined}
              >
                {group}
                <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div class="nav-panel" id={`nav-panel-${group.toLowerCase()}`} hidden>
                <ul role="list">
                  {pages.map((page) => (
                    <li>
                      <a href={href(page.slug)} aria-current={page.slug === current ? 'page' : undefined}>
                        <span class="nav-panel__title">{page.nav}</span>
                        <span class="nav-panel__desc">{page.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
        <li>
          <a class="nav-link" href={href('references')} aria-current={current === 'references' ? 'page' : undefined}>
            References
          </a>
        </li>
      </ul>
      <a class="button button--quiet nav-judging" href={href('judging')} aria-current={current === 'judging' ? 'page' : undefined}>
        Judging guide
      </a>
    </nav>

    <button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" data-menu-open>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      Menu
    </button>
  </div>

  <dialog class="mobile-menu" id="mobile-menu" aria-label="Site menu" data-mobile-menu>
    <div class="mobile-menu__head">
      <a class="brand" href={href('/')}>
        <LogoMark size={28} />
        <span class="brand__name">OncoNose</span>
      </a>
      <button class="menu-toggle menu-toggle--close" type="button" data-menu-close>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        Close
      </button>
    </div>
    <nav aria-label="Main">
      <a class="button mobile-menu__judging" href={href('judging')}>Judging guide</a>
      {
        groups.map(({ group, pages }) => (
          <section class="mobile-menu__group">
            <h2 class="mobile-menu__label">{group}</h2>
            <ul role="list">
              {pages.map((page) => (
                <li>
                  <a href={href(page.slug)} aria-current={page.slug === current ? 'page' : undefined}>
                    {page.nav}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <section class="mobile-menu__group">
        <h2 class="mobile-menu__label">Sources</h2>
        <ul role="list">
          <li>
            <a href={href('references')} aria-current={current === 'references' ? 'page' : undefined}>References</a>
          </li>
        </ul>
      </section>
    </nav>
  </dialog>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-sans);
    view-transition-name: site-header;
  }

  @supports (backdrop-filter: blur(8px)) {
    .site-header {
      background: color-mix(in srgb, var(--paper) 82%, transparent);
      backdrop-filter: blur(10px) saturate(1.2);
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
    border-radius: var(--r-control);
  }

  .brand__name {
    font-size: 1.2rem;
    font-weight: 720;
    font-stretch: 118%;
    letter-spacing: -0.02em;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: var(--sp-4);
  }

  .nav-desktop__list {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-group {
    position: relative;
  }

  .nav-group__trigger,
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border: 0;
    border-radius: var(--r-control);
    background: transparent;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 560;
    text-decoration: none;
    cursor: pointer;
    position: relative;
  }

  .nav-group__trigger:hover,
  .nav-link:hover,
  .nav-group__trigger[aria-expanded='true'] {
    background: var(--paper-sunk);
  }

  .nav-group__trigger svg {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .nav-group__trigger[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  /* Current section: a short bar under the label */
  .nav-group__trigger[data-active='true']::after,
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
  }

  .nav-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: -0.5rem;
    width: 22rem;
    padding: var(--sp-2);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--r-figure);
    box-shadow: var(--shadow-float);
  }

  .nav-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-panel a {
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--r-control);
    text-decoration: none;
    color: var(--ink);
  }

  .nav-panel a:hover {
    background: var(--paper-sunk);
  }

  .nav-panel a[aria-current='page'] {
    background: var(--paper-sunk);
    box-shadow: inset 3px 0 0 var(--ink);
  }

  .nav-panel__title {
    font-weight: 600;
    font-size: 0.975rem;
  }

  .nav-panel__desc {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .nav-judging {
    min-height: 2.5rem;
    padding-block: 0.4rem;
  }

  .nav-judging[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1.5px solid var(--rule-strong);
    border-radius: var(--r-pill);
    background: transparent;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
  }

  @media (min-width: 64rem) {
    .nav-desktop {
      display: flex;
    }

    .menu-toggle {
      display: none;
    }
  }

  /* Mobile menu */
  .mobile-menu {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0 var(--gutter) var(--sp-7);
    border: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    overflow-y: auto;
  }

  .mobile-menu::backdrop {
    background: rgb(21 16 58 / 0.4);
  }

  .mobile-menu__head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--sp-5);
  }

  .mobile-menu__judging {
    width: 100%;
    margin-bottom: var(--sp-5);
  }

  .mobile-menu__group + .mobile-menu__group {
    margin-top: var(--sp-5);
  }

  .mobile-menu__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-3);
    letter-spacing: 0;
    margin-bottom: var(--sp-2);
  }

  .mobile-menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .mobile-menu li a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    border-bottom: 1px solid var(--rule);
    font-size: 1.2rem;
    font-weight: 560;
    text-decoration: none;
  }

  .mobile-menu li a[aria-current='page'] {
    font-weight: 700;
    box-shadow: inset 3px 0 0 var(--ink);
    padding-left: var(--sp-3);
  }
</style>

<script>
  function setupDesktopMenus() {
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-group]'));

    const close = (group: HTMLElement, restoreFocus = false) => {
      const trigger = group.querySelector<HTMLButtonElement>('button')!;
      const panel = group.querySelector<HTMLElement>('.nav-panel')!;
      trigger.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
      if (restoreFocus) trigger.focus();
    };

    groups.forEach((group) => {
      const trigger = group.querySelector<HTMLButtonElement>('button')!;
      const panel = group.querySelector<HTMLElement>('.nav-panel')!;

      trigger.addEventListener('click', () => {
        const open = trigger.getAttribute('aria-expanded') === 'true';
        groups.forEach((g) => g !== group && close(g));
        trigger.setAttribute('aria-expanded', String(!open));
        panel.hidden = open;
      });

      group.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
          event.preventDefault();
          close(group, true);
        }
      });

      group.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (next && !group.contains(next)) close(group);
      });
    });

    document.addEventListener('click', (event) => {
      groups.forEach((group) => {
        if (!group.contains(event.target as Node)) close(group);
      });
    });
  }

  function setupMobileMenu() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
    const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
    if (!dialog || !openButton || !closeButton) return;

    openButton.addEventListener('click', () => {
      dialog.showModal();
      openButton.setAttribute('aria-expanded', 'true');
    });
    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      openButton.setAttribute('aria-expanded', 'false');
      openButton.focus();
    });
    // Close when a same-page anchor is chosen so the target is visible
    dialog.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => dialog.close()));
    // Leaving the mobile breakpoint with the menu open should not trap the page
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches && dialog.open) dialog.close();
    });
  }

  setupDesktopMenus();
  setupMobileMenu();
</script>
