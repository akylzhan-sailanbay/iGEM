---
/**
 * The OncoNose mark: an airway branching into three sensing chambers, one per signal family.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className } = Astro.props;
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <path d="M3 30 C 8 26, 10 23, 12.5 19.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
  <path d="M12.5 19.5 L 18 12.5 M12.5 19.5 L 21 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
  <circle cx="11.5" cy="15" r="5" fill="var(--metabolism)" stroke="currentColor" stroke-width="1.5"></circle>
  <circle cx="20.5" cy="9" r="5.5" fill="var(--oxidative)" stroke="currentColor" stroke-width="1.5"></circle>
  <circle cx="23" cy="20.5" r="5" fill="var(--inflammation)" stroke="currentColor" stroke-width="1.5"></circle>
</svg>
