---
/**
 * Compact evidence marker for use inside tables and lists.
 */
interface Props {
  kind: 'met' | 'open' | 'unmet' | 'planned';
  label?: string;
}
const { kind, label } = Astro.props;
const defaults = {
  met: 'Supported',
  open: 'Open question',
  unmet: 'Not yet',
  planned: 'Planned',
} as const;
---

<span class:list={['pill', `pill--${kind}`]}>
  <span class="pill__dot" aria-hidden="true"></span>
  {label ?? defaults[kind]}
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.6rem 0.15rem 0.5rem;
    border-radius: var(--r-pill);
    border: 1px solid currentColor;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  .pill__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  .pill--met {
    color: var(--metabolism-ink);
  }

  .pill--open {
    color: var(--air-ink);
  }

  .pill--unmet {
    color: var(--inflammation-ink);
  }

  .pill--planned {
    color: var(--ink-2);
  }

  .pill--open .pill__dot {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px currentColor;
  }

  .pill--unmet .pill__dot {
    background: transparent;
    border: 1.5px solid currentColor;
  }
</style>
