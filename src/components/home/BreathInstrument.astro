---
import InstrumentSvg from './InstrumentSvg.astro';
import { families, modules, profiles, profileResponses, familyById } from '../../data/signals';

const reference = profileResponses(profiles[0]);
---

<section class="instrument on-dark" aria-labelledby="instrument-title" data-instrument>
  <div class="instrument__head">
    <h2 id="instrument-title">One breath through OncoNose</h2>
    <p class="instrument__disclaimer">
      Illustrative simulation. The modules, breath profiles and responses are invented to explain the idea. They are not
      measured data.
    </p>
  </div>

  <div class="instrument__body">
    <div class="instrument__stage">
      <fieldset class="profiles" data-profiles>
        <legend>Choose a breath to analyse</legend>
        <div class="profiles__options">
          {
            profiles.map((p, i) => (
              <label class="profile">
                <input type="radio" name="breath-profile" value={p.id} checked={i === 0} />
                <span class="profile__name">{p.name}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <ol class="stages" aria-label="Stages shown in the diagram">
        <li>Breath</li>
        <li>VOCs</li>
        <li>Sensing modules</li>
        <li>Signature</li>
      </ol>
      <p id="instrument-diagram-desc" class="visually-hidden">
        Diagram: exhaled breath enters an inlet, volatile compounds travel through branching airways to six sensing
        modules arranged in three rows, one row per signal family, and the module responses are drawn as a six-pointed
        signature compared against a dashed reference outline. Current module responses are listed in the table after
        the controls.
      </p>
      <InstrumentSvg kind="wide" values={reference} reference={reference} labelledBy="instrument-diagram-desc" />
      <InstrumentSvg kind="tall" values={reference} reference={reference} labelledBy="instrument-diagram-desc" />
    </div>

    <div class="instrument__panel">
      <div class="readout" data-readout>
        <p class="readout__kicker">Screening step (concept)</p>
        <p class="readout__state" data-readout-state aria-live="polite">Close to the reference pattern</p>
        <div class="distance">
          <div class="distance__track" aria-hidden="true">
            <span class="distance__fill" data-distance-fill style="--d:0"></span>
            <span class="distance__threshold"></span>
          </div>
          <p class="distance__labels" aria-hidden="true">
            <span>Reference</span>
            <span class="distance__line-label">Follow-up line</span>
          </p>
        </div>
        <p class="readout__explain" data-readout-explain>{profiles[0].explanation}</p>
      </div>

      <button class="exhale" type="button" data-exhale>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path d="M3 7h9a2.5 2.5 0 1 0-2.5-2.5M3 11h12a2.5 2.5 0 1 1-2.5 2.5M3 15h6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        Run the breath again
      </button>

      <ul class="legend" aria-label="Signal families">
        {
          families.map((f) => (
            <li data-family={f.id}>
              <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true">
                {f.glyph === 'circle' && <circle cx="7" cy="7" r="5" />}
                {f.glyph === 'diamond' && <path d="M7 1.5 12.5 7 7 12.5 1.5 7Z" />}
                {f.glyph === 'triangle' && <path d="M7 1.8 12.6 12H1.4Z" />}
              </svg>
              {f.name}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="visually-hidden">
  <table data-values-table>
    <caption>Simulated module responses for the selected breath (0 to 100)</caption>
    <thead>
      <tr><th scope="col">Module</th><th scope="col">Signal family</th><th scope="col">Response</th><th scope="col">Reference</th></tr>
    </thead>
    <tbody>
      {
        modules.map((m, i) => (
          <tr>
            <th scope="row">{m.label}</th>
            <td>{familyById(m.family).name}</td>
            <td data-value-cell={m.id}>{Math.round(reference[i] * 100)}</td>
            <td>{Math.round(reference[i] * 100)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>
</section>

<style>
  .instrument {
    container-type: inline-size;
    position: relative;
    background: var(--darkfield);
    color: var(--on-dark);
    border-radius: var(--r-device);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    font-family: var(--font-sans);
    /* A faint lattice, like a counting-chamber slide seen through the eyepiece */
    background-image:
      linear-gradient(color-mix(in srgb, var(--darkfield-line) 35%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--darkfield-line) 35%, transparent) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: -1px -1px;
  }

  .instrument__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-6);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--darkfield-line);
  }

  .instrument__head h2 {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    font-stretch: 112%;
  }

  .instrument__disclaimer {
    max-width: 52ch;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--on-dark-2);
  }

  .instrument__body {
    display: grid;
    gap: var(--sp-5);
    margin-top: var(--sp-5);
  }

  .instrument__stage {
    min-width: 0;
  }

  .stages {
    display: none;
    margin: 0 0 var(--sp-2);
    padding: 0;
    list-style: none;
    counter-reset: stage;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--on-dark-2);
  }

  .stages li {
    counter-increment: stage;
  }

  .stages li::before {
    content: counter(stage);
    display: inline-grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    border: 1px solid var(--darkfield-line);
    font-size: 0.75rem;
    color: var(--on-dark);
  }

  .instrument-svg--wide,
  .instrument :global(.instrument-svg--wide) {
    display: none;
  }

  .instrument :global(.instrument-svg--tall) {
    display: block;
    max-width: 24rem;
    margin-inline: auto;
  }

  /* Controls and readout */
  .instrument__panel {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }

  .profiles {
    margin: 0 0 var(--sp-5);
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .profiles__options {
    display: grid;
    gap: var(--sp-2);
  }

  .profiles legend {
    padding: 0;
    margin-bottom: var(--sp-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--on-dark-2);
  }

  .profile {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 2.75rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--darkfield-line);
    border-radius: var(--r-control);
    cursor: pointer;
    font-weight: 560;
    line-height: 1.25;
    transition:
      background-color var(--dur-fast) linear,
      border-color var(--dur-fast) linear;
  }

  .profile:hover {
    background: var(--darkfield-2);
  }

  .profile input {
    appearance: none;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    border-radius: 50%;
    border: 1.5px solid var(--on-dark-2);
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .profile input::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--darkfield);
    transform: scale(0);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .profile input:checked {
    background: var(--air-glow);
    border-color: var(--air-glow);
  }

  .profile input:checked::before {
    transform: scale(1);
  }

  .profile:has(input:checked) {
    background: var(--darkfield-2);
    border-color: var(--air-glow);
  }

  .profile input:focus-visible {
    outline: 3px solid var(--air-glow);
    outline-offset: 3px;
  }

  .exhale {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--r-pill);
    border: 1.5px solid var(--air-glow);
    background: transparent;
    color: var(--on-dark);
    font-weight: 600;
    cursor: pointer;
    justify-self: start;
  }

  .exhale:hover {
    background: color-mix(in srgb, var(--air-glow) 14%, transparent);
  }

  .exhale[aria-disabled='true'] {
    opacity: 0.6;
    cursor: progress;
  }

  :global(html:not(.js)) .profiles,
  :global(html:not(.js)) .exhale {
    display: none;
  }

  .readout {
    padding: var(--sp-4) var(--sp-4) var(--sp-5);
    border-radius: var(--r-figure);
    background: var(--darkfield-2);
    border: 1px solid var(--darkfield-line);
  }

  .readout__kicker {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--on-dark-3);
  }

  .readout__state {
    margin-top: 0.2rem;
    min-height: 2.6em;
    font-size: 1.1rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .distance {
    margin-top: var(--sp-3);
    --line: 33.33%;
  }

  .distance__track {
    position: relative;
    height: 0.5rem;
    border-radius: var(--r-pill);
    background: var(--darkfield);
  }

  .distance__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--d) * 100%);
    border-radius: var(--r-pill);
    background: var(--air-glow);
    transition: width 600ms var(--ease-out);
  }

  .distance__threshold {
    position: absolute;
    top: -0.25rem;
    bottom: -0.25rem;
    left: var(--line);
    width: 2px;
    background: var(--on-dark);
  }

  .distance__labels {
    position: relative;
    height: 1.1rem;
    margin-top: 0.45rem;
    font-size: 0.75rem;
    color: var(--on-dark-3);
  }

  .distance__labels span {
    position: absolute;
    top: 0;
    white-space: nowrap;
  }

  .distance__line-label {
    left: calc(var(--line) + 0.4rem);
  }

  .readout__explain {
    margin-top: var(--sp-3);
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--on-dark-2);
  }

  .legend {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    font-size: var(--text-sm);
    color: var(--on-dark-2);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend svg {
    fill: var(--family-glow);
  }

  /* Medium: tall diagram beside the readout */
  @container (min-width: 36rem) {
    .instrument__body {
      grid-template-columns: minmax(0, 21rem) minmax(0, 1fr);
      align-items: start;
      gap: var(--sp-6);
    }

    .instrument__panel {
      position: sticky;
      top: calc(var(--header-h) + var(--sp-4));
    }
  }

  /* Wide: left-to-right diagram, choices as a row above it */
  @container (min-width: 50rem) {
    .instrument__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .instrument__panel {
      position: static;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      column-gap: var(--sp-6);
      align-items: start;
    }

    .readout {
      grid-row: span 2;
    }

    .instrument :global(.instrument-svg--wide) {
      display: block;
    }

    .instrument :global(.instrument-svg--tall) {
      display: none;
    }

    .profiles__options {
      display: flex;
      flex-wrap: wrap;
    }

    .stages {
      display: grid;
      grid-template-columns: 18.5% 23% 30% 28.5%;
    }
  }

  @container (min-width: 70rem) {
    .instrument__body {
      grid-template-columns: minmax(0, 1fr) 18.5rem;
      gap: var(--sp-7);
    }

    .instrument__panel {
      grid-template-columns: minmax(0, 1fr);
      align-self: stretch;
      align-content: center;
      padding-left: var(--sp-6);
      border-left: 1px solid var(--darkfield-line);
    }

    .readout {
      grid-row: auto;
    }
  }
</style>

<script>
  import { initInstrument } from './breath-instrument';
  document.querySelectorAll<HTMLElement>('[data-instrument]').forEach((root) => initInstrument(root));
</script>
