---
import { questions } from '../../data/home';
import { href } from '../../lib/paths';
---

<section class="questions container" aria-labelledby="questions-title">
  <div class="questions__intro">
    <h2 id="questions-title">Nine questions, answered in order</h2>
    <p>
      The site follows the questions people ask about a new screening idea. Each answer is short here and in full on its
      own page, with sources.
    </p>
  </div>

  <ol class="questions__list">
    {
      questions.map((q, i) => (
        <li class="q">
          <span class="q__n" aria-hidden="true">{i + 1}</span>
          <h3 class="q__question">{q.question}</h3>
          <div class="q__answer">
            <p>{q.answer}</p>
            <a href={href(q.link)} class="q__link">{q.linkLabel}</a>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .questions {
    padding-block: var(--sp-9) var(--sp-8);
  }

  .questions__intro {
    display: grid;
    gap: var(--sp-4);
    padding-bottom: var(--sp-6);
  }

  .questions__intro h2 {
    max-width: 16ch;
  }

  .questions__intro p {
    max-width: 50ch;
    color: var(--ink-2);
  }

  @media (min-width: 60rem) {
    .questions__intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--sp-8);
    }
  }

  .questions__list {
    margin: 0;
    padding: 0;
    list-style: none;
    position: relative;
  }

  .q {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: var(--sp-4);
    row-gap: var(--sp-2);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--rule);
  }

  .q:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .q__n {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    font-family: var(--font-sans);
    font-weight: 650;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  .q__question {
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
    font-stretch: 106%;
    line-height: 1.2;
    padding-top: 0.3rem;
  }

  .q__answer {
    grid-column: 2;
    max-width: 62ch;
  }

  .q__link {
    display: inline-block;
    margin-top: var(--sp-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    padding-block: 0.25rem;
  }

  @media (min-width: 60rem) {
    .q {
      grid-template-columns: 2.25rem minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--sp-6);
      padding-block: var(--sp-6);
    }

    .q__n {
      grid-row: auto;
    }

    .q__answer {
      grid-column: 3;
    }
  }
</style>
