---
import { status } from '../../data/home';
import { href } from '../../lib/paths';

const stateLabel = { done: 'Done', active: 'In progress', planned: 'Planned' } as const;
const lastUpdated = 'September 2026'; // TODO: update when the status list changes
---

<section class="status container" aria-labelledby="status-title">
  <div class="status__head">
    <h2 id="status-title">Where the project stands</h2>
    <p>
      A research project moves from idea to evidence in stages. This is our honest position, updated {lastUpdated}.
      Anything not marked done has no results on this site yet.
    </p>
  </div>

  <ol class="track">
    {
      status.map((stage) => (
        <li class:list={['track__stage', `is-${stage.state}`]}>
          <span class="track__marker" aria-hidden="true" />
          <div class="track__text">
            <p class="track__state">{stateLabel[stage.state]}</p>
            <h3>{stage.name}</h3>
            <p class="track__note">{stage.note}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <p class="status__more">
    For the evidence behind each iGEM criterion, use the <a href={href('judging')}>judging guide</a>.
  </p>
</section>

<style>
  .status {
    padding-block: var(--sp-8);
  }

  .status__head {
    display: grid;
    gap: var(--sp-4);
    margin-bottom: var(--sp-7);
  }

  .status__head p {
    max-width: 58ch;
    color: var(--ink-2);
  }

  @media (min-width: 60rem) {
    .status__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--sp-8);
      align-items: end;
    }
  }

  .track {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    font-family: var(--font-sans);
  }

  .track__stage {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--sp-4);
    padding-bottom: var(--sp-6);
  }

  /* Vertical line between markers */
  .track__stage::before {
    content: '';
    position: absolute;
    left: calc(0.75rem - 1px);
    top: 1.5rem;
    bottom: 0;
    width: 2px;
    background: var(--rule-strong);
  }

  .track__stage.is-done::before {
    background: var(--ink);
  }

  .track__stage:last-child::before {
    display: none;
  }

  .track__marker {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 2px solid var(--rule-strong);
    background: var(--paper);
  }

  .is-done .track__marker {
    border-color: var(--ink);
    background: var(--ink);
    box-shadow: inset 0 0 0 4px var(--paper);
  }

  .is-active .track__marker {
    border-color: var(--ink);
    background: conic-gradient(var(--ink) 0 50%, var(--paper) 50% 100%);
  }

  .track__state {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-3);
  }

  .is-done .track__state,
  .is-active .track__state {
    color: var(--ink);
  }

  .track h3 {
    margin-top: 0.1rem;
    font-size: 1.1rem;
  }

  .track__note {
    margin-top: var(--sp-1);
    font-family: var(--font-serif);
    font-size: 0.975rem;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 44ch;
  }

  /* Horizontal track on wide screens */
  @media (min-width: 70rem) {
    .track {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: var(--sp-5);
    }

    .track__stage {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-4);
      padding-bottom: 0;
    }

    .track__stage::before {
      left: 1.5rem;
      right: calc(-1 * var(--sp-5));
      top: calc(0.75rem - 1px);
      bottom: auto;
      width: auto;
      height: 2px;
    }
  }

  .status__more {
    margin-top: var(--sp-7);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
</style>
