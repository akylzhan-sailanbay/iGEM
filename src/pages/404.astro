---
import BaseLayout from '../layouts/BaseLayout.astro';
import { chapters } from '../data/chapters';
import { href } from '../lib/paths';
---

<BaseLayout title="Page not found" description="That page does not exist on the OncoNose wiki.">
  <section class="notfound container">
    <p class="notfound__code">404</p>
    <h1>That page is not here</h1>
    <p class="lede">
      The link may be out of date, or the page may have been renamed. The chapters below cover the whole project, in
      order.
    </p>
    <ol class="notfound__list">
      {
        chapters.map((chapter) => (
          <li>
            <a href={href(chapter.slug)}>
              <span>{chapter.nav}</span>
              <span class="notfound__q">{chapter.question}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="notfound__more">
      Or start from the <a href={href('/')}>home page</a>, or jump to the{' '}
      <a href={href('judging')}>judging guide</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--sp-9) var(--sp-8);
  }

  .notfound__code {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--ink-3);
  }

  .notfound h1 {
    margin-top: var(--sp-3);
    max-width: 16ch;
  }

  .notfound .lede {
    margin-top: var(--sp-4);
  }

  .notfound__list {
    display: grid;
    gap: 0;
    margin: var(--sp-7) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
    max-width: 44rem;
  }

  .notfound__list a {
    display: grid;
    gap: 0.2rem;
    padding-block: var(--sp-4);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .notfound__list span:first-child {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 620;
  }

  .notfound__list a:hover span:first-child {
    text-decoration: underline;
  }

  .notfound__q {
    font-style: italic;
    color: var(--ink-2);
  }

  .notfound__more {
    margin-top: var(--sp-6);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }
</style>
