---
/**
 * Layout for pages outside the chapter sequence: team, attributions, references, judging guide.
 */
import BaseLayout from './BaseLayout.astro';
import PageToc, { type TocItem } from '../components/layout/PageToc.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lede: string;
  description?: string;
  toc?: TocItem[];
}
const { title, eyebrow, lede, description, toc = [] } = Astro.props;
---

<BaseLayout title={title} description={description ?? lede}>
  <header class="page-head container">
    {eyebrow && <p class="page-head__eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p class="lede page-head__lede">{lede}</p>
  </header>

  <div class="page-body container">
    {
      toc.length > 0 && (
        <aside class="page-body__toc">
          <PageToc items={toc} />
        </aside>
      )
    }
    <div class="page-body__content">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--sp-8) var(--sp-7);
    border-bottom: 1px solid var(--rule);
  }

  .page-head__eyebrow {
    margin-bottom: var(--sp-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .page-head h1 {
    max-width: 20ch;
  }

  .page-head__lede {
    margin-top: var(--sp-5);
  }

  .page-body {
    display: grid;
    gap: var(--sp-5);
    padding-top: var(--sp-6);
  }

  @media (min-width: 64rem) {
    .page-body:has(.page-body__toc) {
      grid-template-columns: 13.5rem minmax(0, 1fr);
      gap: var(--sp-8);
      padding-top: var(--sp-8);
    }
  }

  .page-body__content {
    min-width: 0;
  }
</style>
