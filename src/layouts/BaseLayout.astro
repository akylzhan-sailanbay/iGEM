---
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { site } from '../data/site';
import { href, slugFromPath } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  /** Discourage indexing (used by development-only pages) */
  noindex?: boolean;
}

const { title, description = site.summary, noindex = false } = Astro.props;
const current = slugFromPath(Astro.url.pathname);
const fullTitle = title ? `${title} | OncoNose, iGEM ${site.year}` : `OncoNose: ${site.tagline}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;

const fonts = {
  sans: href('fonts/mona-sans-latin-wdth-normal.woff2'),
  sansExt: href('fonts/mona-sans-latin-ext-wdth-normal.woff2'),
  serif: href('fonts/source-serif-4-latin-opsz-normal.woff2'),
  serifExt: href('fonts/source-serif-4-latin-ext-opsz-normal.woff2'),
  serifItalic: href('fonts/source-serif-4-latin-opsz-italic.woff2'),
};

const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const latinExt =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';

// Fonts are served from this site (iGEM does not allow external font CDNs).
const fontFaces = `
@font-face{font-family:'Mona Sans';font-style:normal;font-display:swap;font-weight:200 900;font-stretch:75% 125%;src:url(${fonts.sans}) format('woff2');unicode-range:${latin}}
@font-face{font-family:'Mona Sans';font-style:normal;font-display:swap;font-weight:200 900;font-stretch:75% 125%;src:url(${fonts.sansExt}) format('woff2');unicode-range:${latinExt}}
@font-face{font-family:'Source Serif 4';font-style:normal;font-display:swap;font-weight:200 900;src:url(${fonts.serif}) format('woff2');unicode-range:${latin}}
@font-face{font-family:'Source Serif 4';font-style:normal;font-display:swap;font-weight:200 900;src:url(${fonts.serifExt}) format('woff2');unicode-range:${latinExt}}
@font-face{font-family:'Source Serif 4';font-style:italic;font-display:swap;font-weight:200 900;src:url(${fonts.serifItalic}) format('woff2');unicode-range:${latin}}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f4f2f7" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="preload" href={fonts.sans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fonts.serif} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
